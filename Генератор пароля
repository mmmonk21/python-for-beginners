import random

digits = '0123456789'
lowercase_letters = 'abcdefghijklmnopqrstuvwxyz'
uppercase_letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
punctuation = '!#$%&*+-=?@^'

chars = ''

count = int(input('Укажите количество паролей для генерации: '))
length = int(input('Укажите длину пароля: '))
ifdig = input('Включать ли цифры (y/n): ')
ABCon = input('Включать ли прописные буквы (y/n): ')
abcon = input('Включать ли строчные буквы (y/n): ')
simbols = input('Включать ли спецсимволы (y/n): ')
excsimb = input('Исключать ли неодназначные символы "il1Lo0O" (y/n): ')

if ifdig == 'y':
    chars += digits
if ABCon == 'y':
    chars += uppercase_letters
if abcon == 'y':
    chars += lowercase_letters
if simbols == 'y':
    chars += punctuation
if excsimb == 'y':
    for c in 'il1Lo0O':
        chars = chars.replace(c, '')

def generate_password():
    password = ''
    for i in range(length):
        password += random.choice(chars)
    return password
    
for i in range(count):
    print(generate_password())
